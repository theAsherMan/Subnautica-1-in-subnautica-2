{
  "enabledPlugins": {
    "context-compactor@sn2-mods": true
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python -I \"$CLAUDE_PROJECT_DIR/src/tools/research_lint_hook.py\"",
            "timeout": 30,
            "statusMessage": "Linting research notes"
          }
        ]
      }
    ]
  }
}
